{
  "max_frames": 36,
  "frame_stride": 1,
  "save_frames": true,
  "jpeg_quality": 88,
  "max_report_frames": 12,
  "run_root": "runs",
  "registry_path": "data/registry/vehicles.csv",
  "detector": {
    "enabled": true,
    "vehicle_model": "yolov8n.pt",
    "plate_model": null,
    "conf": 0.25,
    "iou": 0.45,
    "imgsz": 640,
    "device": "cpu",
    "allow_download": true
  },
  "ocr": {
    "backend": "auto",
    "lang": "en",
    "min_line_conf": 0.15,
    "min_char_conf": 0.22,
    "upscale": 3,
    "use_angle_cls": true
  },
  "fusion": {
    "min_observations": 1,
    "min_chars_per_reading": 4,
    "min_plate_len": 7,
    "max_plate_len": 11,
    "min_support_weight": 0.12,
    "min_vote_share": 0.3,
    "min_char_confidence": 0.28,
    "agreement_bonus": 0.15,
    "class_correction": true
  },
  "attributes": {
    "min_color_conf": 0.3,
    "min_body_conf": 0.35,
    "make_model_min_conf": 0.45
  },
  "matching": {
    "top_k": 5,
    "weight_plate": 0.7,
    "weight_color": 0.18,
    "weight_body": 0.12,
    "weight_make_model": 0.1,
    "min_confidence": 0.45,
    "min_score": 0.52,
    "min_known_chars": 3,
    "min_margin": 0.05,
    "max_high_conf_conflicts": 2,
    "high_conf_threshold": 0.55,
    "confusion_similarity": 0.65
  }
}
