{
  "$defs": {
    "Candidate": {
      "description": "A shortlisted candidate vehicle from the registry with ranking rationale.",
      "properties": {
        "vehicle_id": {
          "description": "Registry record identifier",
          "title": "Vehicle Id",
          "type": "string"
        },
        "registration_number": {
          "description": "Full registration number",
          "title": "Registration Number",
          "type": "string"
        },
        "final_score": {
          "description": "Weighted composite similarity score",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Final Score",
          "type": "number"
        },
        "breakdown": {
          "$ref": "#/$defs/ScoreBreakdown",
          "description": "Component score breakdown"
        },
        "why_match": {
          "description": "Evidence supporting this candidate match",
          "items": {
            "type": "string"
          },
          "title": "Why Match",
          "type": "array"
        },
        "why_not": {
          "description": "Evidence against this candidate or explaining why it is ranked lower",
          "items": {
            "type": "string"
          },
          "title": "Why Not",
          "type": "array"
        }
      },
      "required": [
        "vehicle_id",
        "registration_number",
        "final_score",
        "breakdown"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "FrameVote": {
      "description": "Vote contribution from a specific frame for a character position.",
      "properties": {
        "frame_no": {
          "description": "Frame index that cast this vote",
          "title": "Frame No",
          "type": "integer"
        },
        "char": {
          "description": "Character voted for",
          "title": "Char",
          "type": "string"
        },
        "prob": {
          "description": "Calibrated character probability in frame",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Prob",
          "type": "number"
        },
        "weight": {
          "description": "Normalized weight assigned to this frame",
          "minimum": 0.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "frame_no",
        "char",
        "prob",
        "weight"
      ],
      "title": "FrameVote",
      "type": "object"
    },
    "FusedPlate": {
      "description": "Final consensus plate produced by multi-frame fusion.",
      "properties": {
        "text": {
          "description": "Fused plate text with '?' for uncertain characters",
          "title": "Text",
          "type": "string"
        },
        "per_position": {
          "description": "Evidence and vote breakdown per position",
          "items": {
            "$ref": "#/$defs/PositionVote"
          },
          "title": "Per Position",
          "type": "array"
        },
        "format_valid": {
          "default": false,
          "description": "Whether plate text conforms to Indian license plate grammar",
          "title": "Format Valid",
          "type": "boolean"
        },
        "frames_used": {
          "default": 0,
          "description": "Count of high-quality frames accepted into fusion",
          "minimum": 0,
          "title": "Frames Used",
          "type": "integer"
        },
        "mean_confidence": {
          "default": 0.0,
          "description": "Mean confidence across known positions",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Mean Confidence",
          "type": "number"
        },
        "known_count": {
          "default": 0,
          "description": "Number of resolved characters",
          "minimum": 0,
          "title": "Known Count",
          "type": "integer"
        },
        "unknown_count": {
          "default": 0,
          "description": "Number of '?' positions",
          "minimum": 0,
          "title": "Unknown Count",
          "type": "integer"
        }
      },
      "required": [
        "text"
      ],
      "title": "FusedPlate",
      "type": "object"
    },
    "PositionVote": {
      "description": "Aggregated evidence for a single character slot across all frames.",
      "properties": {
        "index": {
          "description": "0-indexed position along plate string",
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "char_or_?": {
          "description": "Consensus character or '?' if confidence/margin insufficient",
          "maxLength": 1,
          "minLength": 1,
          "title": "Char Or ?",
          "type": "string"
        },
        "confidence": {
          "description": "Posterior probability for accepted character, or margin confidence",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "votes": {
          "description": "Breakdown of individual frame votes contributing to this position",
          "items": {
            "$ref": "#/$defs/FrameVote"
          },
          "title": "Votes",
          "type": "array"
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human-readable reason if marked '?' (e.g. margin < threshold)",
          "title": "Explanation"
        }
      },
      "required": [
        "index",
        "char_or_?",
        "confidence"
      ],
      "title": "PositionVote",
      "type": "object"
    },
    "ScoreBreakdown": {
      "description": "Component-level similarity scores for an evaluated candidate.",
      "properties": {
        "plate": {
          "description": "Positional partial-plate similarity",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Plate",
          "type": "number"
        },
        "colour": {
          "description": "Colour compatibility score",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Colour",
          "type": "number"
        },
        "body": {
          "description": "Body-type compatibility score",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Body",
          "type": "number"
        },
        "visual": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Appearance / embedding similarity score",
          "title": "Visual"
        }
      },
      "required": [
        "plate",
        "colour",
        "body"
      ],
      "title": "ScoreBreakdown",
      "type": "object"
    },
    "VehicleAttributes": {
      "description": "Extracted visual attributes for a detected vehicle.",
      "properties": {
        "colour": {
          "description": "Dominant detected vehicle colour name",
          "title": "Colour",
          "type": "string"
        },
        "colour_conf": {
          "description": "Confidence in detected colour",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Colour Conf",
          "type": "number"
        },
        "body_type": {
          "description": "Classified body type (hatchback, sedan, SUV, two-wheeler, auto-rickshaw, truck, bus)",
          "title": "Body Type",
          "type": "string"
        },
        "body_conf": {
          "description": "Confidence in classified body type",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Body Conf",
          "type": "number"
        },
        "make": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Predicted manufacturer/make if identified",
          "title": "Make"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Predicted vehicle model if identified",
          "title": "Model"
        },
        "colour_distribution": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Probability distribution across candidate colours",
          "title": "Colour Distribution",
          "type": "object"
        },
        "body_distribution": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "Probability distribution across candidate body types",
          "title": "Body Distribution",
          "type": "object"
        },
        "plate_style": {
          "default": "white",
          "description": "Detected plate background style (white, yellow, green, black)",
          "title": "Plate Style",
          "type": "string"
        },
        "plate_style_conf": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Plate Style Conf",
          "type": "number"
        }
      },
      "required": [
        "colour",
        "colour_conf",
        "body_type",
        "body_conf"
      ],
      "title": "VehicleAttributes",
      "type": "object"
    }
  },
  "description": "Complete end-to-end investigation result for a CCTV video clip.",
  "properties": {
    "case_id": {
      "description": "Unique case identifier (UUID or hash)",
      "title": "Case Id",
      "type": "string"
    },
    "clip_name": {
      "description": "Source video file basename",
      "title": "Clip Name",
      "type": "string"
    },
    "fused_plate": {
      "$ref": "#/$defs/FusedPlate",
      "description": "Multi-frame fused plate result"
    },
    "attributes": {
      "$ref": "#/$defs/VehicleAttributes",
      "description": "Extracted vehicle visual attributes"
    },
    "candidates": {
      "description": "Top-5 ranked candidates or empty if no confident match",
      "items": {
        "$ref": "#/$defs/Candidate"
      },
      "maxItems": 5,
      "title": "Candidates",
      "type": "array"
    },
    "decision": {
      "description": "Final decision: either shortlisted candidates found or abstained",
      "enum": [
        "MATCH_FOUND",
        "NO_CONFIDENT_MATCH"
      ],
      "title": "Decision",
      "type": "string"
    },
    "decision_reason": {
      "description": "Plain-English explanation of the decision rationale",
      "title": "Decision Reason",
      "type": "string"
    },
    "thresholds_used": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "Threshold parameters applied during this analysis",
      "title": "Thresholds Used",
      "type": "object"
    },
    "weights_used": {
      "additionalProperties": {
        "type": "number"
      },
      "description": "Ranking weights applied during this analysis",
      "title": "Weights Used",
      "type": "object"
    },
    "created_at": {
      "description": "UTC ISO timestamp of analysis completion",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "case_id",
    "clip_name",
    "fused_plate",
    "attributes",
    "decision",
    "decision_reason"
  ],
  "title": "CaseResult",
  "type": "object"
}